# Copie para .env.local e preencha. NUNCA versionar o .env.local.
# .env.local e .env* ja estao no .gitignore.

# Connection string do Postgres (Supabase -> Project Settings -> Database)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Segredo de assinatura das sessoes (cookie HMAC). OBRIGATORIO: nao existe fallback.
# Gere um valor unico e nunca versione:  openssl rand -base64 48
# Sem esta variavel o processo nao sobe (ver src/lib/auth.ts).
SESSION_SECRET=

# Senha inicial distribuida aos alunos na importacao. OBRIGATORIA: nao existe fallback.
# Atencao: alterar esta variavel NAO troca a senha de quem ja foi importado —
# os hashes ficam em alunos.senha_hash. Troque a senha no banco antes de mudar aqui.
# Evite valores previsiveis como "123456" ou "admin".
STUDENT_DEFAULT_PASSWORD=

# Senha do usuario admin criado pelo reset do banco. OBRIGATORIA para rodar
# scripts/zerar-e-importar.ts com --reset (minimo de 8 caracteres).
# Nao ha valor padrao: sem esta variavel o script aborta antes do TRUNCATE.
ADMIN_INITIAL_PASSWORD=
